---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/starwind/button";
import SectionHeader from "@/components/SectionHeader.astro";
import ContactSection from "@/components/ContactSection.astro";
import { founder, mailto } from "@/lib/site";

const principles = [
  {
    title: "Solve the real problem",
    body: "Start with what is actually slowing the team down, then pick the simplest thing that fixes it.",
  },
  {
    title: "Prefer boring technology",
    body: "Reach for well-understood tools unless there is a clear reason not to. Novelty is not a feature.",
  },
  {
    title: "Make it maintainable",
    body: "Code and systems should be easy for the next engineer to understand and change.",
  },
  {
    title: "Be direct",
    body: "Clear communication about trade-offs, timelines, and risks — including when the answer is no.",
  },
];
---

<Layout
  title="About | Rief Productions"
  description="Rief Productions LLC is the independent software engineering consultancy of Andrew Riefenstahl, a senior full-stack and backend engineer."
>
  <section class="border-b border-border">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-700">
        About
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
        An independent engineering consultancy
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] md:gap-16">
      <div class="space-y-5 text-muted-foreground">
        <p>
          Rief Productions LLC is the independent software engineering
          consultancy of Andrew Riefenstahl. I build and improve software for
          organizations as a contract engineer, a technical consultant, or an
          embedded senior contributor.
        </p>
        <p>
          I have worked on an AI agent workflow platform (Flockx), enterprise web
          systems, nonprofit platforms, and open-source developer tooling, and I
          co-founded a worker-owned technology cooperative.
        </p>
        <p>
          The through-line is systems thinking: understanding how data, services,
          people, and constraints fit together. I care about performance,
          reliability, accessibility, and maintainability.
        </p>
        <p>
          I am a senior software engineer working across architecture, delivery,
          and technical leadership.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <Button
            variant="primary"
            href={mailto("Software engineering inquiry")}
          >
            Start a conversation
          </Button>
          <Button variant="outline" href="/work/">See engineering work</Button>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="rounded-2xl border border-border bg-card p-6">
          <h2 class="text-sm font-semibold">Focus areas</h2>
          <ul class="mt-4 space-y-2.5 text-sm text-muted-foreground">
            {
              [
                "Full-stack application engineering",
                "Backend systems and API design",
                "Architecture and modernization",
                "AI applications and agentic workflows",
                "Automation and developer tooling",
                "Cloud infrastructure and integrations",
              ].map((item) => (
                <li class="flex gap-2.5">
                  <span
                    aria-hidden="true"
                    class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cyan-600"
                  />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6">
          <h2 class="text-sm font-semibold">Elsewhere</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li>
              <a
                class="text-cyan-700 hover:text-cyan-800 starwind-transition-colors"
                href={founder.url}
                target="_blank"
                rel="me noopener">andrewriefenstahl.com</a
              >
            </li>
            <li>
              <a
                class="text-cyan-700 hover:text-cyan-800 starwind-transition-colors"
                href={founder.github}
                target="_blank"
                rel="me noopener">GitHub</a
              >
            </li>
            <li>
              <a
                class="text-cyan-700 hover:text-cyan-800 starwind-transition-colors"
                href={founder.linkedin}
                target="_blank"
                rel="me noopener">LinkedIn</a
              >
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-border bg-muted/40">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <SectionHeader
        eyebrow="Principles"
        title="How I approach the work"
      />
      <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          principles.map((item) => (
            <div>
              <h3 class="text-base font-semibold">{item.title}</h3>
              <p class="mt-2 text-sm text-muted-foreground">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection />
</Layout>
