---
import Layout from "@/layouts/Layout.astro";
import CaseStudy from "@/components/CaseStudy.astro";
import ContactSection from "@/components/ContactSection.astro";
import { projects } from "@/lib/projects";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Selected engineering work",
  itemListElement: projects
    .filter((project) => project.url)
    .map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.name,
      url: project.url,
    })),
};
---

<Layout
  title="Engineering Work | Rief Productions"
  description="Selected engineering work: AI agent platforms, backend and API systems, authentication, cloud infrastructure, payments, migrations, and AI tooling."
  structuredData={structuredData}
>
  <section class="border-b border-border">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-text">
        Selected work
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
        Engineering work
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted-foreground">
        Production systems, platforms, and open-source tooling. Each entry covers
        the problem, the technical approach, the systems involved, and the
        outcome.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
    {
      projects.map((project) => (
        <CaseStudy project={project} />
      ))
    }
  </section>

  <ContactSection />
</Layout>
