---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/starwind/button";
import SectionHeader from "@/components/SectionHeader.astro";
import CapabilityCard from "@/components/CapabilityCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TechStack from "@/components/TechStack.astro";
import ContactSection from "@/components/ContactSection.astro";
import { capabilities } from "@/lib/capabilities";
import { featuredProjects } from "@/lib/projects";
import { site, mailto } from "@/lib/site";

const approach = [
  {
    title: "End-to-end ownership",
    body: "From requirements and architecture through implementation, deployment, and operations.",
  },
  {
    title: "Requirements into systems",
    body: "Translating business needs into data models, interfaces, and services.",
  },
  {
    title: "Pragmatic architecture",
    body: "The right amount of structure for the problem — no over-engineering, no shortcuts that become outages.",
  },
  {
    title: "Built to maintain",
    body: "Readable code, clear boundaries, and documentation the next engineer can follow.",
  },
  {
    title: "Performance and reliability",
    body: "Fast interfaces, sensible caching, and systems that fail gracefully.",
  },
  {
    title: "Effective with existing teams",
    body: "Comfortable working inside an established codebase, process, and team — not just greenfield projects.",
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10"
      style="background-image: radial-gradient(60rem 40rem at 85% -20%, rgba(46, 251, 253, var(--hero-glow)), transparent 70%), radial-gradient(circle at 1px 1px, var(--hero-dot) 1px, transparent 0); background-size: auto, 1.5rem 1.5rem;"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-text"
        >
          Independent software engineering consultancy
        </p>
        <h1
          class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl"
        >
          Software engineering for modern products and systems.
        </h1>
        <p class="mt-6 text-lg text-muted-foreground">
          I'm Andrew Riefenstahl, a senior software engineer. Through Rief
          Productions I design and build full-stack applications, backend systems
          and APIs, AI-enabled workflows, automation, and the cloud
          infrastructure that runs them.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button
            variant="primary"
            size="lg"
            href={mailto("Software engineering inquiry")}
          >
            Discuss a project
          </Button>
          <Button variant="outline" size="lg" href="/work/">
            View selected work
          </Button>
        </div>
        <p class="mt-6 text-sm text-muted-foreground">{site.availability}</p>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <SectionHeader
      eyebrow="Capabilities"
      title="What I build"
      description="The engineering problems I take on most often."
    />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        capabilities.map((capability) => (
          <CapabilityCard
            title={capability.title}
            summary={capability.summary}
            items={capability.items}
          />
        ))
      }
    </div>
  </section>

  <!-- Selected work -->
  <section id="work" class="border-t border-border bg-muted/40">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader
          eyebrow="Selected work"
          title="Systems I have shipped"
          description="A sample of production platforms, backend systems, and open-source tooling."
        />
        <Button variant="outline" href="/work/">All engineering work</Button>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- How I work -->
  <section id="approach" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <SectionHeader
      eyebrow="How I work"
      title="Senior ownership, pragmatic execution"
    />
    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        approach.map((item) => (
          <div>
            <h3 class="text-base font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Technology -->
  <section id="technology" class="border-t border-border bg-muted/40">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <SectionHeader
        eyebrow="Technology"
        title="What I build with"
        description="Tools I have used on shipped projects."
      />
      <TechStack />
    </div>
  </section>

  <!-- About -->
  <section id="about" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <SectionHeader
          eyebrow="About"
          title="Rief Productions"
          description="I work directly with teams as a contract engineer, technical consultant, or embedded senior contributor."
        />
        <p class="mt-5 text-muted-foreground">
          I have delivered production software for enterprises, nonprofits, and an
          AI agent platform, and I co-founded a worker-owned technology
          cooperative.
        </p>
        <div class="mt-6">
          <Button variant="ghost" href="/about/">More about my background</Button>
        </div>
      </div>

      <div class="rounded-2xl border border-border bg-card p-6">
        <h3 class="text-sm font-semibold">Highlights</h3>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {
            [
              "Senior full-stack engineering",
              "Backend & API architecture",
              "AI applications and agents",
              "Cloud infrastructure",
              "Performance & reliability",
              "Technical leadership",
            ].map((item) => (
              <li class="rounded-lg bg-accent/40 dark:bg-accent/10 px-3 py-2 text-sm text-foreground">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <ContactSection />
</Layout>
