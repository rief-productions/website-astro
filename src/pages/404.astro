---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/starwind/button";
---

<Layout
  title="Page not found | Rief Productions"
  description="The page you were looking for could not be found."
  noindex
>
  <section class="mx-auto flex max-w-6xl flex-col items-start px-4 py-24 sm:px-6 md:py-32">
    <p class="text-sm font-semibold text-accent-text">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
      Page not found
    </h1>
    <p class="mt-4 max-w-xl text-muted-foreground">
      The page you were looking for does not exist or has moved.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button variant="primary" href="/">Back home</Button>
      <Button variant="outline" href="/work/">See engineering work</Button>
    </div>
  </section>
</Layout>
