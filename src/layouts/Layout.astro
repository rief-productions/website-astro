---
import "@/styles/starwind.css";
import { Button } from "@/components/starwind/button";
import MobileNav from "@/components/MobileNav.astro";
import { ClientRouter } from "astro:transitions";
import { Image } from "astro:assets";
import logoMark from "@/assets/logo-mark.png";
import { nav, site, founder } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  noindex = false,
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = new URL(image, siteUrl).href;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  if (href.startsWith("/#")) return false;
  const path = href.replace(/\/+$/, "") || "/";
  return currentPath === path || (path !== "/" && currentPath.startsWith(path));
};

const organizationStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site.url}/#organization`,
  name: site.legalName,
  url: site.url,
  description: site.description,
  email: site.email,
  image: socialImage,
  founder: {
    "@type": "Person",
    name: founder.name,
    jobTitle: founder.role,
    url: founder.url,
    sameAs: [founder.linkedin, founder.github, founder.twitter],
  },
  sameAs: [founder.linkedin, founder.github],
  knowsAbout: [
    "Software engineering",
    "Full-stack development",
    "Backend systems",
    "API development",
    "Application architecture",
    "AI application development",
    "Automation",
    "Cloud infrastructure",
  ],
};

const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
};

const structuredDataItems = [
  organizationStructuredData,
  websiteStructuredData,
  ...(structuredData
    ? Array.isArray(structuredData)
      ? structuredData
      : [structuredData]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={founder.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredDataItems)}
    />

    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-secondary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-secondary-foreground"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/70"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex h-16 items-center justify-between gap-4">
          <a
            href="/"
            class="flex items-center gap-3 hover:opacity-80 starwind-transition-opacity"
            aria-label={`${site.name} home`}
          >
            <span
              class="bg-neutral-950 rounded-lg p-1 flex items-center justify-center"
              transition:name="header-logo"
              transition:persist
            >
              <Image
                src={logoMark}
                alt=""
                width={28}
                height={28}
                densities={[1, 2]}
                class="h-7 w-7"
              />
            </span>
            <span class="font-semibold tracking-tight text-lg"
              >{site.name}</span
            >
          </a>

          <nav
            class="hidden md:flex items-center gap-6 text-sm"
            aria-label="Primary"
          >
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "starwind-transition-colors",
                    isActive(item.href)
                      ? "text-foreground font-medium"
                      : "text-muted-foreground hover:text-foreground",
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <div class="hidden md:block">
            <Button variant="primary" href="/#contact">Discuss a project</Button>
          </div>

          <MobileNav items={[...nav]} />
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div
        class="mx-auto max-w-6xl px-4 sm:px-6 py-12 grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]"
      >
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span
              class="bg-neutral-950 rounded-lg p-1.5 flex items-center justify-center"
              transition:name="footer-logo"
              transition:persist
            >
              <Image
                src={logoMark}
                alt=""
                width={24}
                height={24}
                densities={[1, 2]}
                class="h-6 w-6"
              />
            </span>
            <span class="font-semibold">{site.legalName}</span>
          </div>
          <p class="text-sm text-muted-foreground max-w-sm">
            Independent software engineering and technology consulting. Full-stack
            applications, backend systems, AI workflows, automation, and
            architecture.
          </p>
          <p class="text-sm text-muted-foreground mt-3 max-w-sm">
            {site.availability}
          </p>
        </div>

        <nav aria-label="Footer">
          <div class="text-sm font-medium mb-3">Explore</div>
          <ul class="text-sm space-y-2">
            {
              nav.map((item) => (
                <li>
                  <a
                    class="text-muted-foreground hover:text-foreground starwind-transition-colors"
                    href={item.href}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="text-muted-foreground hover:text-foreground starwind-transition-colors"
                href="/studio/"
              >
                Additional capabilities
              </a>
            </li>
          </ul>
        </nav>

        <div>
          <div class="text-sm font-medium mb-3">Contact</div>
          <ul class="text-sm space-y-2">
            <li>
              <a
                class="text-muted-foreground hover:text-foreground starwind-transition-colors"
                href={`mailto:${site.email}`}>{site.email}</a
              >
            </li>
            <li>
              <a
                class="text-muted-foreground hover:text-foreground starwind-transition-colors"
                href={founder.linkedin}
                rel="me noopener"
                target="_blank">LinkedIn</a
              >
            </li>
            <li>
              <a
                class="text-muted-foreground hover:text-foreground starwind-transition-colors"
                href={founder.github}
                rel="me noopener"
                target="_blank">GitHub</a
              >
            </li>
            <li>
              <a
                class="text-muted-foreground hover:text-foreground starwind-transition-colors"
                href={founder.url}
                rel="me noopener"
                target="_blank">andrewriefenstahl.com</a
              >
            </li>
          </ul>
        </div>
      </div>
      <div
        class="border-t border-border py-4 text-center text-xs text-muted-foreground"
      >
        © {new Date().getFullYear()} {site.legalName}. All rights reserved.
      </div>
    </footer>
  </body>
</html>
