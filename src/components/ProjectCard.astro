---
import { Card, CardContent, CardHeader } from "@/components/starwind/card";
import type { Project } from "@/lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Card class="flex flex-col">
  <CardHeader class="p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-lg font-semibold tracking-tight">{project.name}</h3>
        <p class="mt-1 text-sm text-muted-foreground">{project.subtitle}</p>
      </div>
      <span class="whitespace-nowrap text-xs text-muted-foreground"
        >{project.year}</span
      >
    </div>
  </CardHeader>
  <CardContent class="flex flex-1 flex-col p-6 pt-0">
    <p class="text-sm text-muted-foreground">{project.summary}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <li class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">
            {tag}
          </li>
        ))
      }
    </ul>
    {
      project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-cyan-700 hover:text-cyan-800 starwind-transition-colors"
        >
          Visit
          <span aria-hidden="true">↗</span>
          <span class="sr-only"> {project.name} (opens in a new tab)</span>
        </a>
      )
    }
  </CardContent>
</Card>
