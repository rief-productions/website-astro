---
import { Button } from "@/components/starwind/button";

interface Props {
  items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<div class="md:hidden">
  <button
    type="button"
    data-mobile-menu-button
    aria-expanded="false"
    aria-controls="mobile-menu"
    class="inline-flex h-11 w-11 items-center justify-center rounded-md text-foreground hover:bg-foreground/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-outline"
  >
    <span class="sr-only">Toggle navigation menu</span>
    <svg
      class="icon-open h-6 w-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
    <svg
      class="icon-close h-6 w-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</div>

<div
  id="mobile-menu"
  data-mobile-menu
  hidden
  class="absolute inset-x-0 top-16 z-40 border-b border-border bg-background shadow-lg md:hidden"
>
  <nav aria-label="Mobile" class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
    <ul class="flex flex-col">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-2 py-3 text-base text-muted-foreground hover:bg-foreground/5 hover:text-foreground starwind-transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-3 px-2 pb-1">
      <Button variant="primary" href="/#contact" class="w-full">
        Discuss a project
      </Button>
    </div>
  </nav>
</div>

<style>
  [data-mobile-menu-button][aria-expanded="false"] .icon-open {
    display: block;
  }
  [data-mobile-menu-button][aria-expanded="false"] .icon-close {
    display: none;
  }
  [data-mobile-menu-button][aria-expanded="true"] .icon-open {
    display: none;
  }
  [data-mobile-menu-button][aria-expanded="true"] .icon-close {
    display: block;
  }
</style>

<script>
  const initMobileNav = () => {
    const button = document.querySelector<HTMLButtonElement>(
      "[data-mobile-menu-button]",
    );
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!button || !menu || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      if (open) {
        menu.removeAttribute("hidden");
      } else {
        menu.setAttribute("hidden", "");
      }
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 768px)").matches) setOpen(false);
    });
  };

  initMobileNav();
  document.addEventListener("astro:after-swap", initMobileNav);
</script>
