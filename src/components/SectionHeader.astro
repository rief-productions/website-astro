---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className } = Astro.props;
---

<div class:list={["max-w-2xl", className]}>
  {
    eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-700">
        {eyebrow}
      </p>
    )
  }
  <h2 class:list={["text-2xl md:text-3xl font-semibold tracking-tight", eyebrow && "mt-3"]}>
    {title}
  </h2>
  {
    description && (
      <p class="mt-3 text-base text-muted-foreground">{description}</p>
    )
  }
</div>
